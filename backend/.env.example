NODE_ENV=development
PORT=8000
JWT_SECRET=development-secret-change-me
DATABASE_URL=

# Cody/trainer bootstrap. Do not commit a real password.
TRAINER_EMAIL=codysharp011@outlook.com
TRAINER_PASSWORD=
TRAINER_FIRST_NAME=Cody
TRAINER_LAST_NAME=Sharp

# Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Private client file storage (AWS S3 or S3-compatible storage)
S3_BUCKET=
S3_REGION=us-west-2
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Optional for S3-compatible providers:
S3_ENDPOINT=
S3_FORCE_PATH_STYLE=false

# Consultation notification email (Resend)
# Create an API key in Resend. Do not commit the real key.
RESEND_API_KEY=
# For testing, Resend may provide an onboarding sender. For production,
# use an address on a domain you have verified with Resend.
RESEND_FROM=Sharp Fitness <notifications@yourdomain.com>
CONTACT_NOTIFICATION_TO=codysharp011@outlook.com
